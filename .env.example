# Postgres connection string shared by web, worker, and Prisma migrations
DATABASE_URL="postgresql://user:password@localhost:5432/social_suite"

# Base64-encoded 32-byte key used for AES-256-GCM encryption of stored OAuth tokens.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=""

# Auth.js
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"
# Public HTTPS origin for TikTok/OAuth callbacks when local HTTPS is not allowed.
OAUTH_PUBLIC_BASE_URL=""
# Node fetch must use the system HTTP(S) proxy when TikTok is unreachable directly.
# Set NODE_USE_ENV_PROXY=1 in the web start command for Node 24+.

# Media storage (Cloudflare R2 or S3-compatible). Use STORAGE_DRIVER=local for disk uploads.
STORAGE_DRIVER=""
STORAGE_ENDPOINT=""
STORAGE_BUCKET=""
STORAGE_ACCESS_KEY_ID=""
STORAGE_SECRET_ACCESS_KEY=""
STORAGE_PUBLIC_BASE_URL=""

# Platform OAuth app credentials (Google/Meta/Threads/X) are entered per-workspace
# in Settings and stored in the database — not configured here.
